{
  "name": "simpel",
  "version": "2.0.0",
  "description": "Lokal Windows task manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/generate-icon.js && electron-builder",
    "build:noicon": "electron-builder"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "se.simpel.app",
    "productName": "Simpel",
    "copyright": "Copyright © 2024 Simpel",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "Simpel.html"
    ],
    "artifactName": "Simpel-Setup-${version}.exe",
    "win": {
      "target": "nsis",
      "publisherName": "Simpel"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Simpel"
    }
  }
}
